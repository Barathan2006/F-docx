# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="https://localhost:3000"

# PORT: Server port (must be 3000 in AI Studio runtime).
PORT="3000"

# SESSION_SECRET: High-entropy secret for signing HttpOnly session cookies.
SESSION_SECRET="replace-with-32-byte-hex-secret"

# TOKEN_ENCRYPTION_KEY: 32-byte key/passphrase for AES-256-GCM encryption of stored OAuth tokens.
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-encryption-secret"

# ADMIN_EMAILS: Comma-separated list of initial administrator Google emails.
ADMIN_EMAILS="admin@example.com"

# ADMIN_SECRET_CODE: Server-side secret code required for the Admin Access login card (never expose to client).
ADMIN_SECRET_CODE=""

# SQLITE_DB_PATH: Optional path to the SQLite database file.
SQLITE_DB_PATH="./data/fdocx.db"

# FIRESTORE_DATABASE_ID: Optional named Firestore database ID.
FIRESTORE_DATABASE_ID=""
