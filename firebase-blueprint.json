{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted server-managed allowlist marker granting administrative privileges",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["userId", "email", "grantedAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Non-sensitive user profile display information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "profilePictureUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "accountStatus": {
          "type": "string",
          "enum": ["ACTIVE", "DEACTIVATED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["userId", "fullName", "accountStatus", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII user identity record (email, googleId, lastLogin, assigned role)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "googleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "USER"]
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["userId", "googleId", "email", "role", "lastLogin", "updatedAt"]
    },
    "Form": {
      "title": "Form",
      "description": "Form configuration and publication metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PUBLISHED", "SUSPENDED"]
        },
        "publicToken": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accessMode": {
          "type": "string",
          "enum": ["PUBLIC_ANONYMOUS", "REQUIRE_LOGIN"]
        },
        "submissionsEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "ownerId", "title", "status", "publicToken", "accessMode", "submissionsEnabled", "createdAt", "updatedAt"]
    },
    "FormField": {
      "title": "FormField",
      "description": "Individual field inside a form",
      "type": "object",
      "properties": {
        "fieldKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fieldType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "columnHeader": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fieldOrder": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["fieldKey", "ownerId", "fieldType", "label", "columnHeader", "fieldOrder", "updatedAt"]
    },
    "FormResponse": {
      "title": "FormResponse",
      "description": "Submitted form response payload",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "formId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "formOwnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "respondentUserId": {
          "type": "string",
          "maxLength": 128
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "formId", "formOwnerId", "submittedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and security activity log",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUserId": {
          "type": "string",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "action", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Admin-managed platform configuration key/value document",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["key", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted admin allowlist markers"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profile document"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only/Admin-only private PII user identity document"
    },
    "/forms/{formId}": {
      "schema": { "$ref": "#/entities/Form" },
      "description": "Form configuration and publication state"
    },
    "/forms/{formId}/fields/{fieldId}": {
      "schema": { "$ref": "#/entities/FormField" },
      "description": "Ordered custom fields belonging to a form"
    },
    "/forms/{formId}/responses/{responseId}": {
      "schema": { "$ref": "#/entities/FormResponse" },
      "description": "Immutable submissions belonging to a form"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only platform security and administrative audit logs"
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Platform-wide configuration controlled strictly by ADMIN"
    }
  }
}
